// Question 6
// Simulate FIFO Page Replacement Using Queue

#include <stdio.h>

int main()
{
    int pages[] = {1,2,3,4,1,2,5,1,2,3,4,5};
    int frame[3];
    int front = 0;
    int faults = 0;

    for(int i=0;i<3;i++)
        frame[i] = -1;

    for(int i=0;i<12;i++)
    {
        int found = 0;

        for(int j=0;j<3;j++)
        {
            if(frame[j] == pages[i])
            {
                found = 1;
                break;
            }
        }

        if(!found)
        {
            frame[front] = pages[i];
            front = (front + 1) % 3;
            faults++;
        }
    }

    printf("Page Faults = %d\n", faults);

    return 0;
}


