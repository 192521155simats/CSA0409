// Question 3
// Simulate a Ready Queue using Queue

#include <stdio.h>

#define MAX 5

int queue[MAX];
int front = -1, rear = -1;

void enqueue(int process)
{
    if (rear == MAX - 1)
    {
        printf("Queue Full\n");
        return;
    }

    if (front == -1)
        front = 0;

    queue[++rear] = process;
}

void dequeue()
{
    if (front == -1 || front > rear)
    {
        printf("Queue Empty\n");
        return;
    }

    printf("Executing Process %d\n", queue[front]);
    front++;
}

int main()
{
    enqueue(101);
    enqueue(102);
    enqueue(103);

    dequeue();
    dequeue();
    dequeue();

    return 0;
}


