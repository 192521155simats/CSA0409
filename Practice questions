// Question 8
// Create Two Threads that Print Numbers Alternately

#include <stdio.h>
#include <pthread.h>

void *odd(void *arg)
{
    for(int i=1;i<=9;i+=2)
    {
        printf("Odd : %d\n", i);
    }

    return NULL;
}

void *even(void *arg)
{
    for(int i=2;i<=10;i+=2)
    {
        printf("Even : %d\n", i);
    }

    return NULL;
}

int main()
{
    pthread_t t1, t2;

    pthread_create(&t1, NULL, odd, NULL);
    pthread_create(&t2, NULL, even, NULL);

    pthread_join(t1, NULL);
    pthread_join(t2, NULL);

    return 0;
}


// Question 9
// Implement a Bounded Buffer Using Queue

#include <stdio.h>

#define SIZE 5

int buffer[SIZE];
int front = -1, rear = -1;

void produce(int item)
{
    if(rear == SIZE - 1)
    {
        printf("Buffer Full\n");
        return;
    }

    if(front == -1)
        front = 0;

    buffer[++rear] = item;

    printf("Produced %d\n", item);
}

void consume()
{
    if(front == -1 || front > rear)
    {
        printf("Buffer Empty\n");
        return;
    }

    printf("Consumed %d\n", buffer[front]);

    front++;
}

int main()
{
    produce(10);
    produce(20);
    produce(30);

    consume();
    consume();
    consume();

    return 0;
}


// Question 10
// Calculate Average Waiting Time for FCFS Scheduling

#include <stdio.h>

int main()
{
    int burst[] = {5,3,8,6,2};
    int waiting[5];
    int total = 0;

    waiting[0] = 0;

    for(int i=1;i<5;i++)
    {
        waiting[i] = waiting[i-1] + burst[i-1];
    }

    for(int i=0;i<5;i++)
    {
        total += waiting[i];
    }

    printf("Average Waiting Time = %.2f\n", (float)total/5);

    return 0;
}
