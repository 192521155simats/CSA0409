void cs(int a[], int n, int h, int z, char d) {
    int l[100], r[100], nl = 0, nr = 0;
    int i, j, t, m = 0, c = h;

    for (i = 0; i < n; i++) {
        if (a[i] < h)
            l[nl++] = a[i];
        else
            r[nr++] = a[i];
    }

    for (i = 0; i < nr - 1; i++)
        for (j = i + 1; j < nr; j++)
            if (r[i] > r[j]) {
                t = r[i];
                r[i] = r[j];
                r[j] = t;
            }

    for (i = 0; i < nl - 1; i++)
        for (j = i + 1; j < nl; j++)
            if (l[i] > l[j]) {
                t = l[i];
                l[i] = l[j];
                l[j] = t;
            }

    printf("C-SCAN: %d ", h);

    if (d == 'R' || d == 'r') {
        for (i = 0; i < nr; i++) {
            m += abs(c - r[i]);
            c = r[i];
            printf("-> %d ", c);
        }

        m += abs(c - (z - 1));
        c = z - 1;
        printf("-> %d ", c);

        m += z - 1;
        c = 0;
        printf("-> 0 ");

        for (i = 0; i < nl; i++) {
            m += abs(c - l[i]);
            c = l[i];
            printf("-> %d ", c);
        }
    }

    printf("\nSeek Time: %d\n", m);
}

void look(int a[], int n, int h, char d) {
    int l[100], r[100], nl = 0, nr = 0;
    int i, j, t, m = 0, c = h;

    for (i = 0; i < n; i++) {
        if (a[i] < h)
            l[nl++] = a[i];
        else
            r[nr++] = a[i];
    }

    for (i = 0; i < nr - 1; i++)
        for (j = i + 1; j < nr; j++)
            if (r[i] > r[j]) {
                t = r[i];
                r[i] = r[j];
                r[j] = t;
            }

    for (i = 0; i < nl - 1; i++)
        for (j = i + 1; j < nl; j++)
            if (l[i] > l[j]) {
                t = l[i];
                l[i] = l[j];
                l[j] = t;
            }

    printf("LOOK: %d ", h);

    if (d == 'R' || d == 'r') {
        for (i = 0; i < nr; i++) {
            m += abs(c - r[i]);
            c = r[i];
            printf("-> %d ", c);
        }

        for (i = nl - 1; i >= 0; i--) {
            m += abs(c - l[i]);
            c = l[i];
            printf("-> %d ", c);
        }
    }

    printf("\nSeek Time: %d\n", m);
}

int main() {
    int a[100], n, h, z, i;
    char d;

    scanf("%d", &z);
    scanf("%d", &n);

    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &h);
    scanf(" %c", &d);

    cs(a, n, h, z, d);
    look(a, n, h, d);

    return 0;
}
5.#include <stdio.h>
#include <stdlib.h>

void con(int d[], int n, int f, int b[]) {
    int s, i, j, ok;

    b[0] = -1;

    for (s = 0; s <= n - f; s++) {
        ok = 1;

        for (j = s; j < s + f; j++)
            if (d[j])
                ok = 0;

        if (ok) {
            for (i = 0; i < f; i++) {
                b[i] = s + i;
                d[s + i] = 1;
            }
            return;
        }
    }
}

void ind(int d[], int n, int f, int b[]) {
    int i, k = 0;

    for (i = 0; i < n && k < f; i++) {
        if (!d[i]) {
            d[i] = 1;
            b[k++] = i;
        }
    }

    if (k < f)
        b[0] = -1;
}

void fc(int b[], int f, int h) {
    int i, c = h, m = 0;

    printf("FCFS: %d ", h);

    for (i = 0; i < f; i++) {
        m += abs(c - b[i]);
        c = b[i];
        printf("-> %d ", c);
    }

    printf("\nSeek Time: %d\n", m);
}

void ss(int b[], int f, int h) {
    int v[100] = {0};
    int i, k, p, x, min, c = h, m = 0;

    printf("SSTF: %d ", h);

    for (k = 0; k < f; k++) {
        min = 9999;
        p = -1;

        for (i = 0; i < f; i++) {
            if (!v[i]) {
                x = abs(c - b[i]);

                if (x < min) {
                    min = x;
                    p = i;
                }
            }
        }

        v[p] = 1;
        m += min;
        c = b[p];

        printf("-> %d ", c);
    }

    printf("\nSeek Time: %d\n", m);
}

int main() {
    int d[100] = {0}, b[100];
    int n, f, h, am, sm, i;

    scanf("%d", &n);
    scanf("%d", &f);

    scanf("%d", &h);

    scanf("%d", &am);
    scanf("%d", &sm);

    if (am == 1)
        con(d, n, f, b);
    else if (am == 2)
        ind(d, n, f, b);
    else {
        printf("Invalid allocation method");
        return 0;
    }

    if (b[0] == -1) {
        printf("Allocation failed");
        return 0;
    }

    printf("Allocated: ");

    for (i = 0; i < f; i++)
        printf("%d ", b[i]);

    printf("\n");

    if (sm == 1)
        fc(b, f, h);
    else if (sm == 2)
        ss(b, f, h);
    else
        printf("Invalid scheduling method");

    return 0;
}
