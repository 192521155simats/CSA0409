1.#include <stdio.h>

int main() {
    int d[100], n, f, m, i, j, s, ok = 0, c = 0;

    scanf("%d", &n);

    for (i = 0; i < n; i++)
        d[i] = 0;

    scanf("%d", &f);
    scanf("%d", &m);

    if (f > n) {
        printf("Allocation not possible");
        return 0;
    }

    if (m == 1) {
        for (s = 0; s <= n - f; s++) {
            ok = 1;

            for (j = s; j < s + f; j++) {
                if (d[j] == 1) {
                    ok = 0;
                    break;
                }
            }

            if (ok) {
                printf("Contiguous: ");

                for (j = s; j < s + f; j++) {
                    d[j] = 1;
                    printf("%d ", j);
                }

                c = 1;
                break;
            }
        }

        if (!c)
            printf("Contiguous allocation failed");
    }

    else if (m == 2) {
        printf("Linked: ");

        for (i = 0; i < n && c < f; i++) {
            if (d[i] == 0) {
                d[i] = 1;
                printf("%d ", i);
                c++;
            }
        }
    }

    else if (m == 3) {
        d[0] = 1;
        printf("Index: 0\nBlocks: ");

        for (i = 1; i < n && c < f; i++) {
            if (d[i] == 0) {
                d[i] = 1;
                printf("%d ", i);
                c++;
            }
        }
    }

    else
        printf("Invalid method");

    return 0;
}
2.#include <stdio.h>

int main() {
    int b[100], n, r, i, x, k = 0, q;

    scanf("%d", &n);

    for (i = 0; i < n; i++)
        scanf("%d", &b[i]);

    scanf("%d", &r);

    for (i = 0; i < n && k < r; i++) {
        if (b[i] == 0) {
            b[i] = 1;
            k++;
        }
    }

    if (k < r)
        printf("Allocation failed\n");
    else
        printf("Allocation successful\n");

    printf("Bitmap: ");

    for (i = 0; i < n; i++)
        printf("%d ", b[i]);

    printf("\n");

    scanf("%d", &q);

    for (i = 0; i < q; i++) {
        scanf("%d", &x);

        if (x >= 0 && x < n)
            b[x] = 0;
    }

    printf("Bitmap after deallocation: ");

    for (i = 0; i < n; i++)
        printf("%d ", b[i]);

    return 0;
}
3.#include <stdio.h>
#include <stdlib.h>

void fcfs(int a[], int n, int h) {
    int i, m = 0, c = h;

    printf("FCFS: %d ", h);

    for (i = 0; i < n; i++) {
        m += abs(c - a[i]);
        c = a[i];
        printf("-> %d ", c);
    }

    printf("\nSeek Time: %d\n", m);
}

void sstf(int a[], int n, int h) {
    int v[100] = {0};
    int i, k, p, min, x, m = 0, c = h;

    printf("SSTF: %d ", h);

    for (k = 0; k < n; k++) {
        min = 9999;
        p = -1;

        for (i = 0; i < n; i++) {
            if (!v[i]) {
                x = abs(c - a[i]);

                if (x < min) {
                    min = x;
                    p = i;
                }
            }
        }

        v[p] = 1;
        m += min;
        c = a[p];

        printf("-> %d ", c);
    }

    printf("\nSeek Time: %d\n", m);
}

void scan(int a[], int n, int h, int z) {
    int l[100], r[100], nl = 0, nr = 0;
    int i, j, t, m = 0, c = h;

    for (i = 0; i < n; i++) {
        if (a[i] < h)
            l[nl++] = a[i];
        else
            r[nr++] = a[i];
    }

    for (i = 0; i < nl - 1; i++)
        for (j = i + 1; j < nl; j++)
            if (l[i] < l[j]) {
                t = l[i];
                l[i] = l[j];
                l[j] = t;
            }

    for (i = 0; i < nr - 1; i++)
        for (j = i + 1; j < nr; j++)
            if (r[i] > r[j]) {
                t = r[i];
                r[i] = r[j];
                r[j] = t;
            }

    printf("SCAN: %d ", h);

    for (i = 0; i < nr; i++) {
        m += abs(c - r[i]);
        c = r[i];
        printf("-> %d ", c);
    }

    m += abs(c - (z - 1));
    c = z - 1;
    printf("-> %d ", c);

    for (i = 0; i < nl; i++) {
        m += abs(c - l[i]);
        c = l[i];
        printf("-> %d ", c);
    }

    printf("\nSeek Time: %d\n", m);
}

int main() {
    int a[100], n, h, z, i;

    scanf("%d", &z);
    scanf("%d", &n);

    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &h);

    fcfs(a, n, h);
    sstf(a, n, h);
    scan(a, n, h, z);

    return 0;
}
