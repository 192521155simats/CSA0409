#include <stdio.h>

int main() {
    int pageTable[20];
    int pages, page, offset, frameSize;

    printf("Enter number of pages: ");
    scanf("%d",&pages);

    printf("Enter frame size: ");
    scanf("%d",&frameSize);

    printf("Enter Page Table Entries:\n");

    for(int i=0;i<pages;i++) {
        printf("Frame for Page %d: ",i);
        scanf("%d",&pageTable[i]);
    }

    printf("Enter Logical Address (Page Offset): ");
    scanf("%d%d",&page,&offset);

    if(page<pages && offset<frameSize) {
        printf("Page %d mapped to Frame %d\n",page,pageTable[page]);

        int physical=pageTable[page]*frameSize+offset;

        printf("Physical Address = %d\n",physical);
    }
    else
        printf("Invalid Address\n");

    return 0;
}
